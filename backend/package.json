{
  "name": "nogaps-backend",
  "version": "1.0.0",
  "private": true,
  "author": "Alejandra Aimee Rivas Montes and Suk Jin Mun",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch --env-file=.env server.js",
    "seed": "node --env-file=.env seed/seedUsers.js && node --env-file=.env seed/seedActivities.js && node --env-file=.env seed/seedAddresses.js",
    "test": "node --test",
    "lint": "eslint .",
    "format": "prettier --write . --ignore-path ../.prettierignore"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "connect-mongo": "^5.1.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "mongodb": "^6.12.0",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0"
  },
  "engines": {
    "node": ">=20.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2"
  }
}
